# ---- Banco de dados (preenchido automaticamente pela integração MongoDB Atlas da Vercel) ----
MONGODB_URI=
MONGODB_DB_NAME=born_tickets

# ---- Autenticação do admin ----
# Gere um valor aleatório longo e cole aqui (ex: abra o terminal e rode: openssl rand -hex 32)
JWT_SECRET=

# ---- Token de configuração inicial (visite /api/setup?token=ESTE_VALOR uma vez) ----
SETUP_TOKEN=

# ---- Asaas (pagamento) ----
ASAAS_API_KEY=
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=
PIX_KEY=48.891.677/0001-93

# ---- E-mail (envio de ingressos) — via Gmail, de graça, sem precisar de domínio ----
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Born Church

# ---- URL pública do site, depois de publicado ----
PUBLIC_BASE_URL=https://seu-site.vercel.app
